OPENAI_API_KEY=

ASTRA_DB_SECURE_BUNDLE_PATH=
ASTRA_DB_APPLICATION_TOKEN=
ASTRA_DB_KEYSPACE=

# Web app authentication (NextAuth)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
APP_AUTH_EMAIL=
APP_AUTH_PASSWORD=
APP_AUTH_NAME=AviationRAG User

# Manifest integration controls (future/gated; disabled by default)
# These flags are not active in current runtime ingestion.
# AVIATIONRAG_MANIFEST_PATH is local/private and ignored by Git.
AVIATIONRAG_ENABLE_MANIFEST_INTEGRATION=false
AVIATIONRAG_MANIFEST_DRY_RUN=false
AVIATIONRAG_MANIFEST_PATH=data/manifest/documents.jsonl
